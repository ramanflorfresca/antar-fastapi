# Editor/script backups of source files. These are scratch copies from
# in-place edits; git history is the real record, so none of them belong
# in the repo. The patterns below cover every shape that has actually
# landed here: .bak, .bak_<tag>, .bak<n>, .backup, .backup_<tag>,
# .backup.<stamp>, and the <name>.py_orig / <name>_orig form.
*.bak
*.bak.*
*.bak_*
*.bak[0-9]*
*.backup
*.backup.*
*.backup_*
*_orig
*.pre_*.bak

# One-off patch/migration scripts. Applied once against main.py and then
# dead; keep them out of the tree so they cannot be mistaken for live code.
patch_*.py
!patch_iap_renewals.py

llm_comarison.py
/tmp/llm_comparison_*
b_*_v3.json
billionaire_*.json
extract.py
billionaire.py
.env.find_chartid
